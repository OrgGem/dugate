# Copy to a protected, ignored file such as .env.docker.deploy and fill every
# required value from the production secret store/release manifest.
# This file intentionally has no development credentials or usable defaults.
DU_IMAGE_PREFIX=du
DU_IMAGE_TAG=release
DU_PLATFORM_NETWORK=du-platform-net
DU_WORKER_NETWORK=du-worker-net
BIND_ADDRESS=127.0.0.1
ORCHESTRATOR_PORT=3000
ADMIN_SHELL_PORT=3001
NODE_ENV=production

# Provision both databases separately. URL-encode reserved characters in user
# names/passwords. REDIS_URL must identify the already-running Redis/Valkey.
DATABASE_URL=
CONNECTOR_DATABASE_URL=
REDIS_URL=
# Set this to the same reachable external Redis-compatible endpoint as REDIS_URL.
DOCUMENT_CORE_DOCKER_REDIS_URL=

# Stable identity and encryption material. Retain ENCRYPTION_KEY across
# deployments; PostgreSQL-backed metadata/public-upload encryption works with
# this local keyring and does not require Vault. S3 requires Transit below.
RUNTIME_TOKEN=
ADMIN_TOKEN=
ENCRYPTION_KEY=
ADMIN_SHELL_COOKIE_SECRET=
INVOCATION_GRANT_SECRET=
CONNECTOR_INVOCATION_GRANT_SECRET=
SERVICE_IDENTITY_SECRET=
CONNECTOR_ENCRYPTION_KEY=
CONNECTOR_INVOCATION_ENCRYPTION_KEYS=
COST_CONTROL_CONNECTOR_TOKEN=
CONNECTOR_SERVICE_TOKEN=
WORKER_IDENTITY_TOKENS_BY_BUSINESS=
DOCUMENT_CORE_RUNTIME_TOKEN=
LC_RUNTIME_TOKEN=
EXAMPLE_REVIEW_RUNTIME_TOKEN=
DOCUMENT_CORE_IMAGE_DIGEST=
LC_IMAGE_DIGEST=
EXAMPLE_REVIEW_IMAGE_DIGEST=
DU_CONNECTOR_BASE_URLS=

# Bind each slot identity to the actual immutable image digest in the reviewed
# release manifest. Do not use a local-dev marker here.
DU_ORCHESTRATOR_RUNTIME_IDENTITY=
DU_ORCHESTRATOR_RUNTIME_SLOT=
DU_ORCHESTRATOR_RUNTIME_REVISION=
DU_ORCHESTRATOR_RUNTIME_IMAGE_DIGEST=
DU_ORCHESTRATOR_SERVICE_RUNTIME_CONTROL_TOKEN=
CONNECTOR_RUNTIME_SLOT=
CONNECTOR_RUNTIME_IDENTITY=
CONNECTOR_REPLICA_ID=
CONNECTOR_RUNTIME_REVISION=
CONNECTOR_RUNTIME_IMAGE_DIGEST=

# Real-data mode defaults to PostgreSQL storage and forbid plaintext reads.
# For S3, configure a private bucket and the complete Transit identity/options.
ARTIFACT_STORAGE_BACKEND=postgres
DU_DATA_MODE=real
DU_ENCRYPTION_METADATA_ENABLED=true
DU_ENCRYPTION_PUBLIC_UPLOAD_ENABLED=true
DU_METADATA_PLAINTEXT_READ_MODE=forbid
DU_METADATA_PLAINTEXT_WINDOW_START=
DU_METADATA_PLAINTEXT_WINDOW_END=
DU_VAULT_TRANSIT_OPTIONS=
DU_VAULT_TRANSIT_ENC_TOKEN=
DU_VAULT_TRANSIT_DEC_TOKEN=
DU_VAULT_KV_OPTIONS=
DU_VAULT_KV_TOKEN=
DU_SECRET_CATALOG_ACTIVE_KEY_VERSION=
DU_SECRET_CATALOG_KEYRING_JSON=
DU_LOCAL_ENCRYPTION_ACTIVE_KEY_VERSION=
DU_LOCAL_ENCRYPTION_KEYRING_JSON=
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_REGION=
ARTIFACT_S3_ENDPOINT=
ARTIFACT_S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
