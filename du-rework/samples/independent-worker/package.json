{
  "name": "dugate-independent-worker-sample",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone example consumer for the DUGate Runtime v1 protocol",
  "engines": {
    "node": ">=24.21 <25"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/main.js",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "bullmq": "^5.34.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.0"
  }
}
