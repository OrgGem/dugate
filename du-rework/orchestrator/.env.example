# Orchestrator local development template. Copy this to the ignored
# .env.bootstrap.local file, set your already running PostgreSQL and Redis
# endpoints there, then generate .env.local:
#   pnpm run init:local -- --env-file=.env.bootstrap.local
# The dev runner never starts or manages these services.
NODE_ENV=development
DATABASE_URL=postgresql://du:CHANGE_ME@127.0.0.1:15433/du_orchestrator_dev
REDIS_URL=redis://127.0.0.1:16380

# Local app listeners
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=3000
ORCHESTRATOR_INTERNAL_HOST=127.0.0.1
ORCHESTRATOR_INTERNAL_PORT=3002
ORCHESTRATOR_INTERNAL_BASE_URL=http://127.0.0.1:3002
ADMIN_SHELL_HOST=127.0.0.1
ADMIN_SHELL_PORT=3001
DU_ADMIN_WEB=1
CONNECTOR_PORT=8088
HOST=127.0.0.1

# Orchestrator and Connector internal routing
CONNECTOR_REDIS_PREFIX=du:connector:
CONNECTOR_MIGRATION_DIRECTORY=./services/connector/src/db/migrations
RUNTIME_URL=http://127.0.0.1:3002/api/runtime/v1
CONNECTOR_URL=http://127.0.0.1:8088
# Optional: explicit Connector ID routes override the default service route.
# DU_CONNECTOR_BASE_URLS={"*":"http://127.0.0.1:8088"}

# Encrypted local runtime. The local profile generator creates fresh app keys.
AUTO_MIGRATE=false
ARTIFACT_STORAGE_BACKEND=postgres
DU_DATA_MODE=real
DU_ENCRYPTION_METADATA_ENABLED=true
DU_ENCRYPTION_PUBLIC_UPLOAD_ENABLED=true
DU_METADATA_PLAINTEXT_READ_MODE=forbid

# Explicit opt-in to the dev-only mock for Orchestrator KV v2 and Transit.
# This does not configure Connector VAULT_ADDR/AppRole. Leave those unset to
# start Connector without Vault-backed credential resolution, or configure a
# real Connector Vault explicitly for credential read/write workflows.
DU_VAULT_MOCK=true
# DU_VAULT_MOCK_FIXTURE=services/orchestrator/tests/mock-vault/mock-vault.json
DU_VAULT_KV_OPTIONS=
DU_VAULT_KV_TOKEN=
DU_VAULT_TRANSIT_OPTIONS=
DU_VAULT_TRANSIT_ENC_TOKEN=
DU_VAULT_TRANSIT_DEC_TOKEN=
VAULT_ADDR=
VAULT_APPROLE_ROLE_ID=
VAULT_APPROLE_SECRET_ID=
VAULT_APPROLE_MOUNT=approle
VAULT_KV_MOUNT=secret
VAULT_KV_ALLOWED_PREFIX=du/tenants

# init:local generates unique values for the fields below. Keep workers in
# their separate business projects; the Orchestrator dev runner does not start
# sibling workers.
RUNTIME_TOKEN=
ADMIN_TOKEN=
ENCRYPTION_KEY=
ADMIN_SHELL_COOKIE_SECRET=
SERVICE_IDENTITY_SECRET=
INVOCATION_GRANT_SECRET=
CONNECTOR_INVOCATION_GRANT_SECRET=
CONNECTOR_ENCRYPTION_KEY=
CONNECTOR_INVOCATION_ENCRYPTION_KEYS=
CONNECTOR_SERVICE_TOKEN=
WORKER_IDENTITY_TOKENS_BY_BUSINESS=
DOCUMENT_CORE_RUNTIME_TOKEN=
LC_RUNTIME_TOKEN=
EXAMPLE_REVIEW_RUNTIME_TOKEN=
