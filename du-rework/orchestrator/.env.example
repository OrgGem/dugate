# ==============================================================================
# Orchestrator Local Development Environment Configuration
# Copy this file to .env.local: cp .env.example .env.local
# ==============================================================================
NODE_ENV=development

# Infrastructure (PostgreSQL & Redis dev instances)
LOCAL_POSTGRES_PASSWORD=localdevsecret
DATABASE_URL=postgresql://du:localdevsecret@127.0.0.1:15433/du_orchestrator_dev
REDIS_URL=redis://127.0.0.1:16380

# Orchestrator Backend Listener Configuration
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=3000
ORCHESTRATOR_INTERNAL_HOST=127.0.0.1
ORCHESTRATOR_INTERNAL_PORT=3002
ORCHESTRATOR_INTERNAL_BASE_URL=http://127.0.0.1:3002

# Admin Web Portal & BFF Configuration
ADMIN_SHELL_HOST=127.0.0.1
ADMIN_SHELL_PORT=3001
DU_ADMIN_WEB=1

# Connector Configuration
HOST=127.0.0.1
CONNECTOR_PORT=8088
CONNECTOR_REDIS_PREFIX=du:connector:
CONNECTOR_MIGRATION_DIRECTORY=./services/connector/src/db/migrations
RUNTIME_URL=http://127.0.0.1:3002/api/runtime/v1
CONNECTOR_URL=http://127.0.0.1:8088

# Storage & Modes
AUTO_MIGRATE=false
ARTIFACT_STORAGE_BACKEND=postgres
DU_DATA_MODE=synthetic
DU_SYNTHETIC_DATA_ACK={"mode":"synthetic-data-exempt","reason":"Isolated development with generated synthetic fixtures only","approvedBy":"local-developer","acknowledgedAt":"2026-10-11T00:00:00.000Z","isolatedFromRealData":true}

# Security & Secrets (32-byte hex or base64)
RUNTIME_TOKEN=af9f7a8a41f534731fe6af9ab903a35fdd56daa67d547effcf60b4a1c5b6822f
ADMIN_TOKEN=28ff6b8be13877018ea33e5f941fca5d2c4733de1d14b5ca550f30746340be75
