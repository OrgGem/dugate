diff --git a/lib/security-budget.js b/lib/security-budget.js
new file mode 100644
index 0000000000000000000000000000000000000000..07586cef72a947ae591625f07248ab6b2627e679
--- /dev/null
+++ b/lib/security-budget.js
@@ -0,0 +1,39 @@
+'use strict';
+
+// Local backport for GHSA-vfj7-8cjw-p6xm. Not caller-configurable: options
+// cannot disable the ceiling before recursive AST walkers run.
+const MAX_DEPTH = 128;
+const MAX_NODES = 65536;
+
+const depthError = () => {
+  const error = new SyntaxError('Brace pattern exceeds the security nesting limit');
+  error.code = 'ERR_BRACES_DEPTH_LIMIT';
+  return error;
+};
+
+const assertAstBudget = ast => {
+  const pending = [{ node: ast, depth: 0 }];
+  const seen = new WeakSet();
+  let count = 0;
+  while (pending.length) {
+    const { node, depth } = pending.pop();
+    if (node === null || typeof node !== 'object') continue;
+    if (depth > MAX_DEPTH + 1) throw depthError();
+    if (seen.has(node) || ++count > MAX_NODES) {
+      const error = new SyntaxError('Brace AST exceeds the security node budget or repeats a node');
+      error.code = 'ERR_BRACES_AST_LIMIT';
+      throw error;
+    }
+    seen.add(node);
+    if (Array.isArray(node.nodes)) {
+      if (node.nodes.length > MAX_NODES - count - pending.length) {
+        const error = new SyntaxError('Brace AST exceeds the security node budget');
+        error.code = 'ERR_BRACES_AST_LIMIT';
+        throw error;
+      }
+      for (const child of node.nodes) pending.push({ node: child, depth: depth + 1 });
+    }
+  }
+};
+
+module.exports = { MAX_DEPTH, depthError, assertAstBudget };
