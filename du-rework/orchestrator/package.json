{
  "name": "@du/orchestrator-project",
  "version": "0.1.0",
  "private": true,
  "description": "DU Platform Orchestrator standalone project",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "init:local": "node scripts/init-local.cjs",
    "stop": "node scripts/stop.cjs",
    "build": "node scripts/build.cjs",
    "migrate": "node scripts/migrate.cjs",
    "migrate:status": "node scripts/migrate.cjs status",
    "migrate:verify": "node scripts/migrate.cjs verify",
    "migrate:baseline-reviewed": "node scripts/migrate.cjs baseline-reviewed",
    "test:dev": "node --test tests/dev-isolation.test.cjs",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r run clean",
    "docker:up": "node scripts/init-local.cjs --docker && docker compose --env-file .env.local up -d",
    "docker:down": "docker compose --env-file .env.local down",
    "docker:logs": "docker compose --env-file .env.local logs -f"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.18.3"
}
