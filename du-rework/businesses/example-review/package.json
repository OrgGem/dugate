{
  "name": "@du/example-review",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal standalone example business for the DU worker extension boundary",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "start": "node dist/main.js",
    "dev": "node scripts/dev.cjs",
    "dev:check": "node scripts/dev.cjs --check",
    "test": "pnpm run build && jest --runInBand",
    "test:unit": "pnpm run build && jest --runInBand",
    "test:dev-isolation": "node --test tests/dev-runner-isolation.test.cjs",
    "test:integration:workspace": "jest --config jest.integration.config.cjs --runInBand",
    "test:typecheck": "pnpm run build && tsc --noEmit -p tsconfig.test.json",
    "lint": "pnpm run build",
    "clean": "rimraf dist vendor/*/dist"
  },
  "dependencies": {
    "@du/contracts": "workspace:*",
    "@du/document-kit": "workspace:*",
    "@du/worker-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^24.0.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
