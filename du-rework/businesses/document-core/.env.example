# Copy to .env.local and set the existing shared document-core worker token.
RUNTIME_URL=http://127.0.0.1:3002/api/runtime/v1
RUNTIME_TOKEN=
REDIS_URL=redis://127.0.0.1:16380
CONNECTOR_URL=http://127.0.0.1:8088
# For direct production execution, pass an issued short-lived token instead.
CONNECTOR_SERVICE_TOKEN=

# Docker Compose connects to services on the external du-worker-net.
DOCUMENT_CORE_RUNTIME_TOKEN=
DOCUMENT_CORE_DOCKER_RUNTIME_URL=http://orchestrator:3002/api/runtime/v1
DOCUMENT_CORE_DOCKER_REDIS_URL=redis://valkey:6379
DOCUMENT_CORE_DOCKER_CONNECTOR_URL=http://connector:8080
