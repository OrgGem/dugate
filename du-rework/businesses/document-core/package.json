{
  "name": "@du/document-core",
  "version": "1.1.0",
  "description": "Document Core Business containing 6 actions and 28 variants",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "build:deps": "node scripts/build-dependencies.cjs",
    "test:integration": "jest tests/multi-container-e2e.integration.test.ts --runInBand --testPathIgnorePatterns=/__offline_default_excludes_integration__/",
    "test:integration:full": "node scripts/build-dependencies.cjs && jest tests/multi-container-e2e.integration.test.ts --runInBand --testPathIgnorePatterns=/__offline_default_excludes_integration__/",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "clean": "rimraf dist",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test:typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@du/contracts": "workspace:*",
    "@du/document-kit": "workspace:*",
    "@du/egress": "workspace:*",
    "@du/worker-sdk": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^24.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.0",
    "bullmq": "^5.34.0"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
