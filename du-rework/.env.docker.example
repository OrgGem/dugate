# Copy to .env.docker and provision secrets, or generate LOCAL credentials:
# node scripts/docker/init-env.cjs .env.docker
# docker compose --env-file .env.docker up -d --build
# Empty required secrets intentionally make Compose refuse to start.
POSTGRES_USER=du
POSTGRES_PASSWORD=
POSTGRES_DB=du_orchestrator
BIND_ADDRESS=127.0.0.1
ORCHESTRATOR_PORT=3000
# Trusted worker-reachable origin for Runtime grants; never derive it from request Host.
ORCHESTRATOR_INTERNAL_BASE_URL=http://orchestrator:3002
# IAM-authenticated source buckets; disabled unless explicitly allowed by tenant.
# See docs/s3-role-source-ingestion.md. No credentials belong in these rules.
DU_S3_SOURCE_RULES=[]
ADMIN_SHELL_PORT=3001
# Optional host ports for the explicit local-debug overlay only; mappings stay on 127.0.0.1.
ORCHESTRATOR_INTERNAL_DEBUG_PORT=3002
CONNECTOR_DEBUG_PORT=8080
# Optional worker endpoint override; default is http://orchestrator:3002/api/runtime/v1.
RUNTIME_URL=
DU_IMAGE_PREFIX=du
DU_IMAGE_TAG=local
RUNTIME_TOKEN=
ADMIN_TOKEN=
ENCRYPTION_KEY=
ADMIN_SHELL_COOKIE_SECRET=
DU_ADMIN_WEB=0
# Set local, oidc or both in production, and provision that identity source.
DU_ADMIN_AUTH_MODE=
DU_ADMIN_TRUST_PROXY_PROTOCOL=false
# Raw ASCII 32-byte grant key for Orchestrator, base64 of SAME bytes for Connector.
INVOCATION_GRANT_SECRET=
CONNECTOR_INVOCATION_GRANT_SECRET=
# Shared Connector-verification / Orchestrator-management identity key and Connector encryption key.
# SERVICE_IDENTITY_SECRET is base64-encoded 32-byte key; it stays server-side and is never sent to Portal/browser.
SERVICE_IDENTITY_SECRET=
CONNECTOR_ENCRYPTION_KEY=
# Optional JSON map of connector id to management base URL, e.g. {"default":"http://connector:8080"}.
DU_CONNECTOR_BASE_URLS=
# Signed HS256 token: aud=connector, scopes=[connector:invoke], future exp.
# NOT the raw SERVICE_IDENTITY_SECRET. Provision/refresh via your identity issuer.
CONNECTOR_SERVICE_TOKEN=
# Optional Connector usage sink. Leave URL/token unset to keep delivery disabled.
# When enabled, point URL to http://orchestrator:3002/api/runtime/v1/usage-events.
USAGE_SINK_URL=
USAGE_SINK_TOKEN=
# Read-only effective-config check for the opt-in debug overlay:
# docker compose --env-file .env.docker -f docker-compose.yml -f compose/local-debug.yml config
# To start with those loopback-only debug mappings, append: up -d --build
ARTIFACT_STORAGE_BACKEND=postgres
DOCUMENT_CORE_CONCURRENCY=2
LC_CONCURRENCY=4
EXAMPLE_REVIEW_CONCURRENCY=2
