# Local-only profile. Copy to .env.docker and fill secrets, or generate fresh
# synthetic LOCAL credentials with the helper below. The generated identity is
# for local development/config preflight and is not a production image claim.
# node scripts/docker/init-env.cjs .env.docker
# For deployment use .env.docker.deploy.example and scripts/docker/check-env.cjs --deploy.
# Empty required secrets intentionally make Compose refuse to start.
POSTGRES_USER=du
POSTGRES_PASSWORD=
POSTGRES_DB=du_orchestrator
DATABASE_URL=
REDIS_URL=redis://valkey:6379
NODE_ENV=development
BIND_ADDRESS=127.0.0.1
ORCHESTRATOR_PORT=3000
# Trusted worker-reachable origin for Runtime grants; never derive it from request Host.
ORCHESTRATOR_INTERNAL_BASE_URL=http://orchestrator:3002
# IAM-authenticated source buckets; disabled unless explicitly allowed by tenant.
# See docs/s3-role-source-ingestion.md. No credentials belong in these rules.
DU_S3_SOURCE_RULES=[]
ADMIN_SHELL_PORT=3001
# Optional host ports for the explicit local-debug overlay only; mappings stay on 127.0.0.1.
ORCHESTRATOR_INTERNAL_DEBUG_PORT=3002
CONNECTOR_DEBUG_PORT=8080
# Optional worker endpoint override; default is http://orchestrator:3002/api/runtime/v1.
RUNTIME_URL=
DU_IMAGE_PREFIX=du
DU_IMAGE_TAG=local
RUNTIME_TOKEN=
DOCUMENT_CORE_RUNTIME_TOKEN=
LC_RUNTIME_TOKEN=
EXAMPLE_REVIEW_RUNTIME_TOKEN=
# JSON map matching the three distinct worker tokens above.
WORKER_IDENTITY_TOKENS_BY_BUSINESS=
ADMIN_TOKEN=
ENCRYPTION_KEY=
ADMIN_SHELL_COOKIE_SECRET=
DU_ADMIN_WEB=0
# Set local, oidc or both in production, and provision that identity source.
DU_ADMIN_AUTH_MODE=
DU_ADMIN_TRUST_PROXY_PROTOCOL=false
# Raw ASCII 32-byte grant key for Orchestrator, base64 of SAME bytes for Connector.
INVOCATION_GRANT_SECRET=
CONNECTOR_INVOCATION_GRANT_SECRET=
# Shared Connector-verification / Orchestrator-management identity key and Connector encryption key.
# SERVICE_IDENTITY_SECRET is base64-encoded 32-byte key; it stays server-side and is never sent to Portal/browser.
SERVICE_IDENTITY_SECRET=
CONNECTOR_ENCRYPTION_KEY=
CONNECTOR_INVOCATION_ENCRYPTION_KEYS=
# Separate Connector PostgreSQL database. The local-only connector-db-init helper
# creates du_connector after you explicitly select --profile local-bootstrap.
CONNECTOR_DATABASE_URL=
# Dedicated internal Connector-to-Orchestrator budget/price authorization key.
COST_CONTROL_CONNECTOR_TOKEN=
# Supply the pinned per-slot runtime identity from the deployment manifest for each service.
DU_ORCHESTRATOR_RUNTIME_IDENTITY=
DU_ORCHESTRATOR_RUNTIME_SLOT=
DU_ORCHESTRATOR_RUNTIME_REVISION=
DU_ORCHESTRATOR_RUNTIME_IMAGE_DIGEST=
DU_ORCHESTRATOR_SERVICE_RUNTIME_CONTROL_TOKEN=
CONNECTOR_RUNTIME_SLOT=
CONNECTOR_RUNTIME_IDENTITY=
CONNECTOR_REPLICA_ID=
CONNECTOR_RUNTIME_REVISION=
CONNECTOR_RUNTIME_IMAGE_DIGEST=
# Root-owned managed storage credential reference; required when ARTIFACT_STORAGE_BACKEND=s3.
DU_STORAGE_CREDENTIAL_VERSION_REF=
DU_STORAGE_CREDENTIAL_OWNER_TENANT_ID=
DU_STORAGE_ENDPOINT_ALLOWLIST=[]
# Retain old key versions while encrypted catalog rows reference them.
DU_SECRET_CATALOG_ACTIVE_KEY_VERSION=
DU_SECRET_CATALOG_KEYRING_JSON=
DU_ADMIN_LOCAL_SERVICE_SECRET=
SHUTDOWN_BUDGET_MS=30000
# Optional JSON map of connector id to management base URL, e.g. {"default":"http://connector:8080"}.
DU_CONNECTOR_BASE_URLS=
# Signed HS256 token: aud=connector, scopes=[connector:invoke], future exp.
# NOT the raw SERVICE_IDENTITY_SECRET. Provision/refresh via your identity issuer.
CONNECTOR_SERVICE_TOKEN=
# Optional Connector usage sink. Leave URL/token unset to keep delivery disabled.
# When enabled, point URL to http://orchestrator:3002/api/runtime/v1/usage-events.
USAGE_SINK_URL=
USAGE_SINK_TOKEN=
# Read-only effective-config check for the opt-in debug overlay:
# docker compose --env-file .env.docker -f docker-compose.yml -f compose/local-debug.yml config
# To start with those loopback-only debug mappings, append: up -d --build
ARTIFACT_STORAGE_BACKEND=postgres
# PostgreSQL-backed encryption uses the retained ENCRYPTION_KEY. Vault Transit
# is required for encrypted S3 storage or when explicitly selecting Transit.
DU_DATA_MODE=real
DU_SYNTHETIC_DATA_ACK=
DU_ENCRYPTION_METADATA_ENABLED=true
DU_ENCRYPTION_PUBLIC_UPLOAD_ENABLED=true
DU_METADATA_PLAINTEXT_READ_MODE=forbid
DU_SOURCE_CREDENTIAL_ORIGIN_MODE=warn
DU_METADATA_PLAINTEXT_WINDOW_START=
DU_METADATA_PLAINTEXT_WINDOW_END=
DU_VAULT_TRANSIT_OPTIONS=
DU_VAULT_TRANSIT_ENC_TOKEN=
DU_VAULT_TRANSIT_DEC_TOKEN=
# Example options (replace host and key names with provisioned Vault Transit keys):
# DU_VAULT_TRANSIT_OPTIONS={"vaultAddress":"http://vault:8200","allowedKeyRefs":{"metadata":"du-metadata","artifacts":"du-artifacts"},"metadataKeyRef":"metadata","publicUploadKeyRef":"artifacts"}
# Vault is external to this Compose stack; make its configured address reachable.
DU_VAULT_KV_OPTIONS=
DU_VAULT_KV_TOKEN=
DU_CONNECTOR_INITIAL_BINDINGS=
DOCUMENT_CORE_CONCURRENCY=2
LC_CONCURRENCY=4
EXAMPLE_REVIEW_CONCURRENCY=2
