{
  "name": "@du/orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "DU platform orchestrator: public API, registry, durable runtime (vertical slice)",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --config jest.unit.config.cjs",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "logs:collect": "node dist/log-collector.js",
    "migrate": "npm run build && node dist/migrate-cli.js migrate",
    "migrate:status": "npm run build && node dist/migrate-cli.js status",
    "migrate:verify": "npm run build && node dist/migrate-cli.js verify",
    "backfill:metadata": "npm run build && node dist/modules/encryption/backfill-metadata-cli.js",
    "migrate:artifact-blobs": "pnpm run build && node dist/storage-migration-cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@du/contracts": "workspace:*",
    "@du/egress": "workspace:*",
    "@du/observability": "workspace:*",
    "@du/worker-sdk": "workspace:*",
    "ajv": "^8.17.1",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.6",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
