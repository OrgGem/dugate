# ==============================================================================
# du-rework — Sample Local Development Environment (.env.local)
# Giả định PostgreSQL và Redis server đã chạy sẵn ở localhost
# Cách dùng: Copy file này thành `.env.local` hoặc `.env` trong thư mục `du-rework`
# ==============================================================================

# ── 1. CƠ SỞ DỮ LIỆU & CACHE (PostgreSQL & Redis trên Localhost) ───────────────
# Lưu ý: Đổi postgres:postgres theo username/password của PostgreSQL trên máy bạn.
# Tạo database trước: CREATE DATABASE du_orchestrator;
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/du_orchestrator
REDIS_URL=redis://127.0.0.1:6379

# ── 2. ORCHESTRATOR SERVICE (Port 3000) ───────────────────────────────────────
ORCHESTRATOR_PORT=3000
# Token tối thiểu 32 ký tự dùng để xác thực giao tiếp giữa các service và admin
RUNTIME_TOKEN=dev_runtime_token_super_secret_min_32_chars
ADMIN_TOKEN=dev_admin_token_super_secret_min_32_chars
ADMIN_SHELL_COOKIE_SECRET=dev_cookie_secret_super_secret_32_chars
ADMIN_SHELL_PORT=3001
AUTO_MIGRATE=false

# Lưu trữ artifact: 'postgres' (lưu thẳng DB, không cần S3 khi dev) hoặc 's3'
ARTIFACT_STORAGE_BACKEND=postgres

# ── 3. CONNECTOR SERVICE (Port 8088 / 8080) ──────────────────────────────────
CONNECTOR_PORT=8088
CONNECTOR_REDIS_PREFIX=du:connector:
SERVICE_IDENTITY_SECRET=nCwZJJzd9E9/L5zkl7guuqIHLGm7GAFJpGnAWb5oxTo=
INVOCATION_GRANT_SECRET=4TVYzMa0A5lCNrYY00Hb2nMz7Zhjc+Q7IRguauSmngg=
# Key mã hóa AES-256 (base64 của 32 bytes)
CONNECTOR_ENCRYPTION_KEY=JkfxSXSNv9dy56bWh0w+CVfHU3EWaw+IA/5AcB8CVnc=
CONNECTOR_MIGRATION_DIRECTORY=./services/connector/src/db/migrations

# ── 4. DOCUMENT-CORE WORKER ───────────────────────────────────────────────────
RUNTIME_URL=http://localhost:3000/api/runtime/v1
CONNECTOR_URL=http://localhost:8080
CONNECTOR_SERVICE_TOKEN=dev_service_identity_secret_32chars
DOCUMENT_CORE_CONCURRENCY=2
HEARTBEAT_INTERVAL_MS=10000
SHUTDOWN_GRACE_MS=15000

# ── 5. RV0104 LIVE TEST (MinIO + Vault dev, local-only) ─────────────────────────
# Test rv0104-live-encryption.test.ts tự skip khi thiếu infra hoặc thiếu token.
# KHÔNG bao giờ commit token thật vào repo — tạo token tạm trên Vault dev local:
#   vault token create -policy=du_test_rv0101_enc -ttl=1h   (chạy 2 lần: enc + dec)
#RV0104_VAULT_ENC_TOKEN=
#RV0104_VAULT_DEC_TOKEN=
